{
    frankenphp
    order php_server before file_server
}

:8080 {
    root * /app/public
    encode zstd br gzip

    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "SAMEORIGIN"
        Referrer-Policy "strict-origin-when-cross-origin"
        -Server
    }

    @health path /up /api/health
    php_server
}