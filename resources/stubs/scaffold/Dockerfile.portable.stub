# ==============================================================================
# PORTABLE MULTI-STAGE PRODUCTION DOCKERFILE (Zero Host Bind-Mount Pitfalls)
# Project : {{ APP_NAME }}
# Pipeline: Stage 1 (Composer Vendor) -> Stage 2 (Node/Vite Build w/ Vendor)
#           -> Stage 3 (PHP 8.5 FPM App) -> Stage 4 (Nginx 1.27 Web)
# ==============================================================================

# ------------------------------------------------------------------------------
# STAGE 1: Composer Vendor Dependencies (MUST run BEFORE Vite/Tailwind build
# so @import / @source rules referencing ../../vendor/* resolve cleanly)
# ------------------------------------------------------------------------------
FROM composer:2 AS composer-vendor

WORKDIR /app

COPY composer.json composer.lock* ./
RUN composer install \
    --no-dev \
    --no-scripts \
    --no-autoloader \
    --prefer-dist \
    --no-interaction \
    --ignore-platform-reqs

COPY artisan ./
COPY app ./app
COPY bootstrap ./bootstrap
COPY config ./config
COPY database ./database
COPY routes ./routes

RUN composer dump-autoload --optimize --no-dev --no-interaction --ignore-platform-reqs

# ------------------------------------------------------------------------------
# STAGE 2: Frontend Vite + Tailwind CSS v4 Asset Compilation (w/ Vendor Copied)
# ------------------------------------------------------------------------------
FROM node:22-alpine AS assets

WORKDIR /app

COPY package.json package-lock.json* ./
RUN if [ -f package-lock.json ]; then \
        npm ci --no-audit --no-fund; \
    else \
        npm install --no-audit --no-fund; \
    fi

# Critical stage dependency: make Composer packages (e.g. Flux/Laravel views) available to Vite
COPY --from=composer-vendor /app/vendor ./vendor
COPY vite.config.js ./
COPY resources ./resources
COPY public ./public

RUN npm run build

# ------------------------------------------------------------------------------
# STAGE 3: PHP 8.5 FPM Application Runtime
# ------------------------------------------------------------------------------
FROM php:8.5-fpm-alpine AS app

LABEL maintainer="Project OS Software Factory"
LABEL project="{{ SHORT_SLUG }}"

RUN apk add --no-cache \
    bash \
    curl \
    git \
    postgresql-dev \
    postgresql-client \
    libpng-dev \
    libzip-dev \
    icu-dev \
    oniguruma-dev \
    freetype-dev \
    libjpeg-turbo-dev \
    zip \
    unzip \
    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS linux-headers \
    && docker-php-ext-configure gd --with-freetype --with-jpeg \
    && docker-php-ext-install -j$(nproc) \
        pdo_pgsql \
        pdo_mysql \
        mbstring \
        exif \
        pcntl \
        bcmath \
        gd \
        zip \
        intl \
        opcache \
    && pecl install redis \
    && docker-php-ext-enable redis \
    && apk del .build-deps

WORKDIR /var/www/html

COPY --chown=www-data:www-data . .
COPY --from=composer-vendor --chown=www-data:www-data /app/vendor ./vendor
COPY --from=assets --chown=www-data:www-data /app/public/build ./public/build

RUN mkdir -p \
        storage/app/public \
        storage/framework/cache \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && chown -R www-data:www-data storage bootstrap/cache \
    && chmod -R 775 storage bootstrap/cache

EXPOSE 9000
CMD ["php-fpm"]

# ------------------------------------------------------------------------------
# STAGE 4: Nginx 1.27 Web Server (Serves Built Vite Static Assets + Proxies PHP)
# ------------------------------------------------------------------------------
FROM nginx:1.27-alpine AS web

WORKDIR /var/www/html

COPY docker/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY public ./public
COPY --from=assets /app/public/build ./public/build

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

