# ==============================================================================
# APPLICATION ENVIRONMENT BLUEPRINT // {{ APP_NAME }}
# Sector          : {{ SECTOR_CODE }} ({{ SECTOR_TITLE }})
# Design System   : {{ DESIGN_SYSTEM_CODE }}
# Custom Folder   : {{ SHORT_SLUG }}
# ==============================================================================

# Docker Compose Project & Container Naming
COMPOSE_PROJECT_NAME={{ SHORT_SLUG }}
APP_PORT={{ APP_PORT }}

APP_NAME="{{ APP_NAME }}"
APP_ENV=local
APP_KEY=base64:GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
APP_DEBUG=true
APP_URL={{ APP_URL }}

APP_LOCALE={{ LOCALE }}
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

# PostgreSQL 16 (Strict ULID Mode)
DB_CONNECTION=pgsql
DB_HOST={{ DB_HOST }}
DB_PORT={{ DB_PORT }}
DB_DATABASE={{ DB_DATABASE }}
DB_USERNAME={{ DB_USERNAME }}
DB_PASSWORD={{ DB_PASSWORD }}

# Isolated Test Database Guard (prevent php artisan test from touching primary DB)
TEST_DB_DATABASE={{ DB_DATABASE }}_testing

# Redis 7 In-Memory Cache & Queue Broker (phpredis native extension)
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST={{ REDIS_HOST }}
REDIS_PASSWORD={{ REDIS_PASSWORD }}
REDIS_PORT=6379

# Mail / Transactional SMTP
MAIL_MAILER=smtp
MAIL_HOST={{ MAIL_HOST }}
MAIL_PORT={{ MAIL_PORT }}
MAIL_USERNAME={{ MAIL_USERNAME }}
MAIL_PASSWORD={{ MAIL_PASSWORD }}
MAIL_FROM_ADDRESS="{{ ADMIN_SEED_EMAIL }}"
MAIL_FROM_NAME="${APP_NAME}"

# Initial Seeded Operator / Superadmin Credentials (change in production!)
ADMIN_SEED_NAME="{{ ADMIN_SEED_NAME }}"
ADMIN_SEED_EMAIL="{{ ADMIN_SEED_EMAIL }}"
ADMIN_SEED_PASSWORD="{{ ADMIN_SEED_PASSWORD }}"

# Cybersecurity & Compliance Guard
AI_THREAT_SHIELD_ENABLED=true
UU_PDP_ENCRYPTION_REQUIRED=true
{{ STACK_EXTRA_ENV }}
