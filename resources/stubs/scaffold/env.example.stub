APP_NAME="{{ APP_NAME }}"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

# Docker Compose Custom Project & Container Naming
COMPOSE_PROJECT_NAME={{ SHORT_SLUG }}
APP_PORT=8080
DB_FORWARD_PORT=5432
REDIS_FORWARD_PORT=6379

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE={{ SHORT_SLUG }}_db
DB_USERNAME={{ SHORT_SLUG }}_user
DB_PASSWORD=secret_production_change_me

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX={{ SHORT_SLUG }}_cache_

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@{{ SLUG }}.com"
MAIL_FROM_NAME="\${APP_NAME}"

# AI-Shield & Autonomous Exploit Defense Settings
AI_SHIELD_ENABLED=true
AI_SHIELD_STRIKE_LIMIT=3
AI_SHIELD_BAN_HOURS=2
SECURE_DATASET_SANDBOX=true

# Midtrans / Payment Gateway Integration
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=
MIDTRANS_IS_PRODUCTION=false