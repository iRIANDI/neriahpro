# ==============================================================================
# PROJECT OS // COOLIFY PRODUCTION DEPLOYMENT STACK
# Project: {{ APP_NAME }}
# Generated: Coolify 1-Click Turnkey Architecture
# ==============================================================================

services:
  # 1. Main PHP 8.4/8.5 FPM Backend Service
  app:
    build:
      context: .
      dockerfile: Dockerfile
    restart: always
    working_dir: /var/www/html
    volumes:
      - ./:/var/www/html
      - ./storage:/var/www/html/storage
    environment:
      APP_NAME: "${APP_NAME:-{{ APP_NAME }}}"
      APP_ENV: production
      APP_KEY: "${APP_KEY}"
      APP_DEBUG: "${APP_DEBUG:-false}"
      APP_URL: "${COOLIFY_URL:-http://localhost}"
      DB_CONNECTION: pgsql
      DB_HOST: postgres
      DB_PORT: 5432
      DB_DATABASE: "${DB_DATABASE:-{{ SHORT_SLUG }}_db}"
      DB_USERNAME: "${DB_USERNAME:-{{ SHORT_SLUG }}_user}"
      DB_PASSWORD: "${DB_PASSWORD:-secret_coolify_change_me}"
      CACHE_STORE: redis
      SESSION_DRIVER: redis
      QUEUE_CONNECTION: redis
      REDIS_HOST: redis
      REDIS_PORT: 6379
      AI_THREAT_SHIELD_ENABLED: "true"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

  # 2. Nginx Web Server (Exposed via Coolify Reverse Proxy & Traefik SSL)
  web:
    image: nginx:alpine
    restart: always
    volumes:
      - ./:/var/www/html:ro
      - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf:ro
    depends_on:
      - app
    environment:
      - "COOLIFY_APP_PORT=80"
    labels:
      - "coolify.managed=true"

  # 3. Production PostgreSQL 16 (Strict ULID Standard)
  postgres:
    image: postgres:16-alpine
    restart: always
    environment:
      POSTGRES_DB: "${DB_DATABASE:-{{ SHORT_SLUG }}_db}"
      POSTGRES_USER: "${DB_USERNAME:-{{ SHORT_SLUG }}_user}"
      POSTGRES_PASSWORD: "${DB_PASSWORD:-secret_coolify_change_me}"
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./database/migrations/schema_complete.sql:/docker-entrypoint-initdb.d/init.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USERNAME:-{{ SHORT_SLUG }}_user} -d ${DB_DATABASE:-{{ SHORT_SLUG }}_db}"]
      interval: 5s
      timeout: 5s
      retries: 5

  # 4. In-Memory Cache & Queue Broker (Redis 7)
  redis:
    image: redis:7-alpine
    restart: always
    command: redis-server --appendonly yes --maxmemory 256mb --maxmemory-policy allkeys-lru
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5

volumes:
  postgres_data:
  redis_data:
