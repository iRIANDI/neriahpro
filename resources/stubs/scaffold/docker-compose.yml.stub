# ==============================================================================
# DEVELOPMENT & LOCAL DOCKER COMPOSE ORCHESTRATION
# Project: {{ APP_NAME }} ({{ SHORT_SLUG }})
# Run : docker compose up --build -d
# Note: For zero-bind-mount portable builds, use docker-compose.portable.yml
# ==============================================================================

name: {{ SHORT_SLUG }}

services:
  app:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: {{ SHORT_SLUG }}_app
    restart: unless-stopped
    working_dir: /var/www/html
    volumes:
      - ./:/var/www/html
      - app_vendor:/var/www/html/vendor
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      APP_NAME: "{{ APP_NAME }}"
      APP_ENV: local
      DB_CONNECTION: pgsql
      DB_HOST: postgres
      DB_PORT: 5432
      DB_DATABASE: {{ DB_DATABASE }}
      DB_USERNAME: {{ DB_USERNAME }}
      DB_PASSWORD: {{ DB_PASSWORD }}
      REDIS_CLIENT: phpredis
      REDIS_HOST: redis
      REDIS_PORT: 6379
      REDIS_PASSWORD: {{ REDIS_PASSWORD }}
      CACHE_STORE: redis
      SESSION_DRIVER: redis
      QUEUE_CONNECTION: redis
    networks:
      - app_network

  web:
    image: nginx:1.27-alpine
    container_name: {{ SHORT_SLUG }}_web
    restart: unless-stopped
    ports:
      - "{{ APP_PORT }}:80"
    volumes:
      - ./:/var/www/html
      - ./docker/nginx/default.conf:/etc/nginx/conf.d/default.conf
    depends_on:
      - app
    networks:
      - app_network

  postgres:
    image: postgres:16-alpine
    container_name: {{ SHORT_SLUG }}_postgres
    restart: unless-stopped
    environment:
      POSTGRES_DB: {{ DB_DATABASE }}
      POSTGRES_USER: {{ DB_USERNAME }}
      POSTGRES_PASSWORD: {{ DB_PASSWORD }}
    ports:
      - "{{ DB_PORT }}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./database/migrations/schema_complete.sql:/docker-entrypoint-initdb.d/01-schema.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U {{ DB_USERNAME }} -d {{ DB_DATABASE }}"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - app_network

  redis:
    image: redis:7-alpine
    container_name: {{ SHORT_SLUG }}_redis
    restart: unless-stopped
    command: >
      redis-server --appendonly yes --maxmemory 256mb --maxmemory-policy allkeys-lru
      --requirepass "{{ REDIS_PASSWORD }}"
    ports:
      - "6379:6379"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD-SHELL", "REDISCLI_AUTH=\"{{ REDIS_PASSWORD }}\" redis-cli ping | grep PONG"]
      interval: 5s
      timeout: 3s
      retries: 10
    networks:
      - app_network{{ REALTIME_COMPOSE_SERVICES }}

volumes:
  app_vendor:
  postgres_data:
  redis_data:

networks:
  app_network:
    driver: bridge
