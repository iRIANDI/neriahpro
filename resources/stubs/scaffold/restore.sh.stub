#!/usr/bin/env bash
# ==============================================================================
# DISASTER RECOVERY // DATABASE RESTORE VERIFICATION DRILL
# Target SLA: Recovery Time Objective (RTO) < 1 Hour
# ==============================================================================

set -euo pipefail

BACKUP_FILE="\${1:-}"

if [ -z "\${BACKUP_FILE}" ] || [ ! -f "\${BACKUP_FILE}" ]; then
  echo "Penggunaan: ./scripts/restore.sh /path/to/backup.sql.gz"
  exit 1
fi

echo ">>> [RESTORE DRILL] Restoring database snapshot into verification database..."

# Temporary verification database name
VERIFY_DB="{{ SLUG }}_verify_drill"

docker exec {{ SLUG }}_postgres psql -U {{ SLUG }}_user -c "DROP DATABASE IF EXISTS \${VERIFY_DB};"
docker exec {{ SLUG }}_postgres psql -U {{ SLUG }}_user -c "CREATE DATABASE \${VERIFY_DB};"

gunzip -c "\${BACKUP_FILE}" | docker exec -i {{ SLUG }}_postgres psql -U {{ SLUG }}_user -d "\${VERIFY_DB}"

echo ">>> [RESTORE DRILL SUCCESS] Backup snapshot is healthy and verified."
docker exec {{ SLUG }}_postgres psql -U {{ SLUG }}_user -c "DROP DATABASE \${VERIFY_DB};"