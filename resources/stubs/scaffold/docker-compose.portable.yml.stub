# ==============================================================================
# PORTABLE PRODUCTION DOCKER COMPOSE STACK
# Project: {{ APP_NAME }} ({{ SHORT_SLUG }})
# Usage  : docker compose -f docker-compose.portable.yml up --build -d
# ==============================================================================

name: {{ SHORT_SLUG }}

services:
  app:
    build:
      context: .
      dockerfile: Dockerfile.portable
      target: app
    container_name: {{ SHORT_SLUG }}_app_portable
    restart: unless-stopped
    working_dir: /var/www/html
    volumes:
      - app_storage:/var/www/html/storage
    environment:
      APP_NAME: "{{ APP_NAME }}"
      APP_ENV: "${APP_ENV:-production}"
      APP_DEBUG: "${APP_DEBUG:-false}"
      APP_URL: "${APP_URL:-{{ APP_URL }}}"
      DB_CONNECTION: pgsql
      DB_HOST: postgres
      DB_PORT: 5432
      DB_DATABASE: "${DB_DATABASE:-{{ DB_DATABASE }}}"
      DB_USERNAME: "${DB_USERNAME:-{{ DB_USERNAME }}}"
      DB_PASSWORD: "${DB_PASSWORD:-{{ DB_PASSWORD }}}"
      REDIS_CLIENT: phpredis
      REDIS_HOST: redis
      REDIS_PORT: 6379
      REDIS_PASSWORD: "${REDIS_PASSWORD:-{{ REDIS_PASSWORD }}}"
      CACHE_STORE: redis
      SESSION_DRIVER: redis
      QUEUE_CONNECTION: redis
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    networks:
      - app_network

  web:
    build:
      context: .
      dockerfile: Dockerfile.portable
      target: web
    container_name: {{ SHORT_SLUG }}_web_portable
    restart: unless-stopped
    ports:
      - "{{ APP_PORT }}:80"
    depends_on:
      - app
    networks:
      - app_network

  postgres:
    image: postgres:16-alpine
    container_name: {{ SHORT_SLUG }}_postgres_portable
    restart: unless-stopped
    environment:
      POSTGRES_DB: "${DB_DATABASE:-{{ DB_DATABASE }}}"
      POSTGRES_USER: "${DB_USERNAME:-{{ DB_USERNAME }}}"
      POSTGRES_PASSWORD: "${DB_PASSWORD:-{{ DB_PASSWORD }}}"
    ports:
      - "{{ DB_PORT }}:5432"
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./database/migrations/schema_complete.sql:/docker-entrypoint-initdb.d/01-schema.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USERNAME:-{{ DB_USERNAME }}} -d ${DB_DATABASE:-{{ DB_DATABASE }}}"]
      interval: 5s
      timeout: 5s
      retries: 10
    networks:
      - app_network

  redis:
    image: redis:7-alpine
    container_name: {{ SHORT_SLUG }}_redis_portable
    restart: unless-stopped
    command: >
      redis-server --appendonly yes --maxmemory 256mb --maxmemory-policy allkeys-lru
      --requirepass "${REDIS_PASSWORD:-{{ REDIS_PASSWORD }}}"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD-SHELL", "REDISCLI_AUTH=\"${REDIS_PASSWORD:-{{ REDIS_PASSWORD }}}\" redis-cli ping | grep PONG"]
      interval: 5s
      timeout: 3s
      retries: 10
    networks:
      - app_network{{ REALTIME_COMPOSE_SERVICES }}

volumes:
  app_storage:
  postgres_data:
  redis_data:

networks:
  app_network:
    driver: bridge

