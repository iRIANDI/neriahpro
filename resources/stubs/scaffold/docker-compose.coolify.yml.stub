# ==============================================================================
# PROJECT OS // COOLIFY PRODUCTION DEPLOYMENT STACK
# Project: {{ APP_NAME }} ({{ SHORT_SLUG }})
# ==============================================================================

services:
  app:
    build:
      context: .
      dockerfile: Dockerfile.portable
      target: app
    restart: always
    working_dir: /var/www/html
    volumes:
      - app_storage:/var/www/html/storage
    environment:
      APP_NAME: "${APP_NAME:-{{ APP_NAME }}}"
      APP_ENV: production
      APP_KEY: "${APP_KEY}"
      APP_DEBUG: "${APP_DEBUG:-false}"
      APP_URL: "${COOLIFY_URL:-{{ APP_URL }}}"
      DB_CONNECTION: pgsql
      DB_HOST: postgres
      DB_PORT: 5432
      DB_DATABASE: "${DB_DATABASE:-{{ DB_DATABASE }}}"
      DB_USERNAME: "${DB_USERNAME:-{{ DB_USERNAME }}}"
      DB_PASSWORD: "${DB_PASSWORD:-{{ DB_PASSWORD }}}"
      REDIS_CLIENT: phpredis
      CACHE_STORE: redis
      SESSION_DRIVER: redis
      QUEUE_CONNECTION: redis
      REDIS_HOST: redis
      REDIS_PORT: 6379
      REDIS_PASSWORD: "${REDIS_PASSWORD:-{{ REDIS_PASSWORD }}}"
      AI_THREAT_SHIELD_ENABLED: "true"
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy

  web:
    build:
      context: .
      dockerfile: Dockerfile.portable
      target: web
    restart: always
    depends_on:
      - app
    environment:
      - "COOLIFY_APP_PORT=80"
    labels:
      - "coolify.managed=true"

  postgres:
    image: postgres:16-alpine
    restart: always
    environment:
      POSTGRES_DB: "${DB_DATABASE:-{{ DB_DATABASE }}}"
      POSTGRES_USER: "${DB_USERNAME:-{{ DB_USERNAME }}}"
      POSTGRES_PASSWORD: "${DB_PASSWORD:-{{ DB_PASSWORD }}}"
      PGDATA: /var/lib/postgresql/data/pgdata
    volumes:
      - postgres_data:/var/lib/postgresql/data
      - ./database/migrations/schema_complete.sql:/docker-entrypoint-initdb.d/01-schema.sql:ro
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USERNAME:-{{ DB_USERNAME }}} -d ${DB_DATABASE:-{{ DB_DATABASE }}}"]
      interval: 5s
      timeout: 5s
      retries: 5

  redis:
    image: redis:7-alpine
    restart: always
    command: >
      redis-server --appendonly yes --maxmemory 256mb --maxmemory-policy allkeys-lru
      --requirepass "${REDIS_PASSWORD:-{{ REDIS_PASSWORD }}}"
    volumes:
      - redis_data:/data
    healthcheck:
      test: ["CMD-SHELL", "REDISCLI_AUTH=\"${REDIS_PASSWORD:-{{ REDIS_PASSWORD }}}\" redis-cli ping | grep PONG"]
      interval: 5s
      timeout: 3s
      retries: 5{{ REALTIME_COMPOSE_SERVICES }}

volumes:
  app_storage:
  postgres_data:
  redis_data:
